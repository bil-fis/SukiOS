# ============================================================================
# SukiOS .gitignore
# 仅忽略构建产物与编辑器临时文件；源码、include、results/、osdev_wiki/ 均保留。
# ============================================================================

# ---- 构建产物（build/ 下全部生成物：.o/.elf/.bin/.iso/.img/.log/.map）----
/build/

# ---- 交叉工具链（从源码构建，不入库）----
# src/      : gcc/binutils 源码包与解压目录
# opt/      : 安装的工具链（opt/bin 下的 x86_64-sukios-elf-*）
# cross-build/ : 交叉工具链构建中间目录
/src/
/opt/
/cross-build/

# 若将来有散落在源码树内的产物，也一并忽略（保险）
*.o
*.elf
*.bin
*.iso
*.img
*.map
*.log

# ---- 编辑器 / IDE 临时文件 ----
*.swp
*~
*.swo
.vscode/
.idea/
clangd-files/
compile_commands.json
.codebuddy/

# ---- 本地环境 ----
.env
makeenv.local

# osdev 文档
osdev_wiki/

# ---- 大体积参考资料 / 测试媒体（不入库）----
high-definition-audio-specification.html
high-definition-audio-specification.pdf
others_tests/

# ---- minimp3：第三方库，完整纳入版本控制（版权见 NOTICE）----
# 上游 https://github.com/lieff/minimp3 ，CC0 公共领域。

# ---- newlib：仅作本地参考，不入库源码（见 NOTICE）----
# 用户态 libc 实现参考 newlib 4.6.0，但源码不纳入仓库（避免数千无关文件
# 膨胀仓库）。磁盘文件保留供本地阅读，不参与版本控制。
lib/newlib-4.6.0.20260123/

# ---- 压缩包 ----
zipres/

# ---- Web 相关内容 (为后续使用html技术构建图形界面准备) ----
dist/
node_modules/

# ---- 其他文件 -----
.gdbinit
*.mp4

# ---- 私有签名证书 ----
*rootCA*
*_sign*
!*.crt
CG*.bmp