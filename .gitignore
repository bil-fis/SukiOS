# ============================================================================
# SukiOS .gitignore
# 仅忽略构建产物与编辑器临时文件；源码、include、results/、osdev_wiki/ 均保留。
# ============================================================================

# ---- 构建产物（build/ 下全部生成物：.o/.elf/.bin/.iso/.img/.log/.map）----
/build/

# 若将来有散落在源码树内的产物，也一并忽略（保险）
*.o
*.elf
*.bin
*.iso
*.img
*.map
*.log

# ---- 编辑器 / IDE 临时文件 ----
*.swp
*~
*.swo
.vscode/
.idea/
clangd-files/
compile_commands.json

# ---- 本地环境 ----
.env
makeenv.local

# osdev 文档
osdev_wiki/

# ---- 大体积参考资料 / 测试媒体（不入库）----
high-definition-audio-specification.html
high-definition-audio-specification.pdf
others_tests/

# ---- minimp3：外部依赖（内嵌 git 仓库，不入库）----
# 构建 playaudio 前需自行获取：git clone https://github.com/lieff/minimp3
minimp3/

# ---- 压缩包 ----
zipres/

# ---- Web 相关内容 (为后续使用html技术构建图形界面准备) ----
dist/
node_modules/

# ---- 其他文件 -----
.gdbinit